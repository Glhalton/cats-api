generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cat {
  id        String   @id @default(uuid())
  name      String
  age       Int
  breed     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cats")
}

model Dog {
  id        String   @id @default(uuid())
  name      String
  age       Int
  breed     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dogs")
}

model Bird {
  id        String   @id @default(uuid())
  name      String
  age       Int
  breed     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("birds")
}

model Horse {
  id        String   @id @default(uuid())
  name      String
  age       Int
  breed     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("horses")
}
